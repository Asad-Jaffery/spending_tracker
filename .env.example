# Local development; run `alembic upgrade head` before starting the API.
DATABASE_URL=sqlite:///./data/spend_tracker.db
# Later: use the Supabase direct or session-pooler Postgres connection string.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres?sslmode=require
JEV_MIN_CONFIDENCE=0.80
MAX_UPLOAD_BYTES=5242880
MAX_IMPORT_ROWS=10000
DEFAULT_CURRENCY=USD
