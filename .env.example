# Copy this file to .env and add a key from https://jevmodel.org/
JEVMODEL_API_KEY=

# Optional local JSON path. Defaults to data/spend-tracker.json.
# SPEND_TRACKER_DATA=data/spend-tracker.json

# Local PostgreSQL (used instead of JSON when set):
# SPEND_TRACKER_DATABASE_URL=postgresql:///spend_tracker_local

# Or use a hosted PostgreSQL URL (including Supabase Postgres):
# SPEND_TRACKER_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
